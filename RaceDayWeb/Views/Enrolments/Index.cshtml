@model EnrolmentListViewModel

@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Enrolments</h2>
        <p class="lead mb-0">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
    </div>
    <div>
        <a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Back to events</a>
        <a asp-controller="Results" asp-action="Index" asp-route-eventId="@Model.Event.EventID" class="btn btn-primary">Enter results</a>
    </div>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="alert alert-info">Nobody has enrolled for this event yet.</div>
}
else
{
    <p>@Model.Enrolments.Count participant(s) enrolled.</p>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Race number</th>
                <th>Participant</th>
                <th>Category</th>
                <th>Enrolled on</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (EnrolmentItem en in Model.Enrolments)
            {
                <tr>
                    <td>@en.RaceNumber</td>
                    <td>@en.ParticipantName</td>
                    <td>@en.CategoryName</td>
                    <td>@en.RegistrationDate.ToString("dd MMM yyyy")</td>
                    <td><partial name="_StatusBadge" model="en.Status" /></td>
                </tr>
            }
        </tbody>
    </table>
}