@model EnrolmentListViewModel

@{
    ViewData["Title"] = "Enter results";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Enter results</h2>
        <p class="lead mb-0">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
    </div>
    <a asp-controller="Events" asp-action="Index" class="btn btn-secondary">Back to events</a>
</div>

@if (Model.Event.EventDate.Date > DateTime.Today)
{
    <div class="alert alert-warning">
        This event has not taken place yet. You can enter results from the event date.
    </div>
}
else if (Model.Enrolments.Count == 0)
{
    <div class="alert alert-info">Nobody enrolled for this event, so there are no results to enter.</div>
}
else
{
    <p class="text-muted">Saving a result publishes it. The participant can see it straight away.</p>

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Race number</th>
                <th>Participant</th>
                <th>Category</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            @foreach (EnrolmentItem en in Model.Enrolments)
            {
                <tr>
                    <td>@en.RaceNumber</td>
                    <td>@en.ParticipantName</td>
                    <td>@en.CategoryName</td>
                    <td>
                        <form asp-action="Save" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="EventID" value="@Model.Event.EventID" />
                            <input type="hidden" name="EnrolmentID" value="@en.EnrolmentID" />
                            <input type="hidden" name="ResultID" value="@en.ResultID" />

                            <select name="Status" class="form-select form-select-sm" style="width:110px">
                                <option value="Finished" selected="@(en.ResultStatus == "Finished")">Finished</option>
                                <option value="DNF" selected="@(en.ResultStatus == "DNF")">DNF</option>
                                <option value="DNS" selected="@(en.ResultStatus == "DNS")">DNS</option>
                                <option value="DSQ" selected="@(en.ResultStatus == "DSQ")">DSQ</option>
                            </select>

                            <input type="number" name="Position" value="@en.Position" min="1" class="form-control form-control-sm" style="width:90px" placeholder="Position" />
                            <input type="text" name="FinishTime" value="@en.FinishTime" class="form-control form-control-sm" style="width:110px" placeholder="hh:mm:ss" />

                            <button type="submit" class="btn btn-sm btn-success text-nowrap">Save &amp; publish</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">DNF = did not finish, DNS = did not start, DSQ = disqualified.</p>
}