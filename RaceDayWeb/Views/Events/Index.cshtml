@model List<EventItem>

@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My events</h1>
    <a asp-action="Create" class="btn btn-primary">Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Banner</th>
                <th>Event</th>
                <th>Date</th>
                <th>Location</th>
                <th>Distance</th>
                <th>Type</th>
                <th>Enrolled</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (EventItem e in Model)
            {
                <tr>
                    <td><img src="@Images.Banner(e.BannerUrl)" alt="Banner for @e.EventName" class="rd-thumb" /></td>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@e.Location</td>
                    <td>@e.DistanceKm km</td>
                    <td>@e.EventType</td>
                    <td>@e.EnrolmentCount</td>
                    <td class="text-nowrap">
                        <a asp-controller="EventDetails" asp-action="Index" asp-route-id="@e.EventID" class="btn btn-sm btn-outline-primary">View</a>
                        <a asp-action="Edit" asp-route-id="@e.EventID" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-secondary">Categories</a>
                        <a asp-controller="Enrolments" asp-action="Index" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-secondary">Enrolments</a>
                        <a asp-controller="Results" asp-action="Index" asp-route-eventId="@e.EventID" class="btn btn-sm btn-outline-secondary">Results</a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <input type="hidden" name="id" value="@e.EventID" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}