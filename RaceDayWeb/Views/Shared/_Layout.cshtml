@using Microsoft.AspNetCore.Http
@using RaceDayWeb.Helpers
@{
    string role = Context.Session.GetString(SessionKeys.Role);
    string fullName = Context.Session.GetString(SessionKeys.FullName);
    string picture = Context.Session.GetString(SessionKeys.Picture);

    // each role gets its own coloured label in the navbar
    string pillClass = "rd-role-participant";
    if (role == Roles.Organiser)
        pillClass = "rd-role-organiser";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDayWeb</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDayWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <header>
            <nav class="navbar navbar-expand-md navbar-dark rd-navbar">
                <div class="container-fluid">
                    <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">RACE<span>DAY</span></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse">
                        <ul class="navbar-nav me-auto">

                            @if (role == null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                                </li>
                            }
                            else if (role == Roles.Organiser)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Events" asp-action="Index">My Events</a>
                                </li>
                            }
                            else if (role == Roles.Participant)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a>
                                </li>
                            }

                        </ul>

                        @if (role != null)
                        {
                            <div class="d-flex align-items-center gap-2 py-2">
                                <img src="@Images.Profile(picture)" alt="" class="rd-avatar" />
                                <div class="text-white lh-sm">
                                    <div>@fullName</div>
                                    <span class="badge rd-role-pill @pillClass">@role</span>
                                </div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-2">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </nav>
        </header>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="rd-footer">
        <div class="container">
            &copy; @DateTime.Now.Year RaceDay &middot; Run. Walk. Cycle.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
