@model ParticipantHomeViewModel

@{
    ViewData["Title"] = "Events";
}

<h1>Upcoming events</h1>
<p class="lead">Find your next race and enter in a few clicks.</p>

<form method="get" asp-action="Index" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label for="search" class="form-label">Search by name or location</label>
            <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="e.g. Joburg" />
        </div>
        <div class="col-md-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                <option value="Run" selected="@(Model.Type == "Run")">Run</option>
                <option value="Walk" selected="@(Model.Type == "Walk")">Walk</option>
                <option value="Cycle" selected="@(Model.Type == "Cycle")">Cycle</option>
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <input type="checkbox" id="showPast" name="showPast" value="true" class="form-check-input" checked="@Model.ShowPast" />
                <label class="form-check-label" for="showPast">Include past events</label>
            </div>
        </div>
        <div class="col-md-2 d-grid gap-1">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="alert alert-info">No events match your filters. Try clearing them.</div>
}
else
{
    <div class="row">
        @foreach (EventItem e in Model.Events)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <img src="@Images.Banner(e.BannerUrl)" alt="Banner for @e.EventName" class="card-img-top rd-card-img" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="mb-0">@e.EventName</h4>
                            <span class="badge rd-type-pill">@e.EventType</span>
                        </div>

                        <p class="mb-1"><strong>Date:</strong> @e.EventDate.ToString("dd MMM yyyy")</p>
                        <p class="mb-1"><strong>Location:</strong> @e.Location</p>
                        <p class="mb-3"><strong>Distance:</strong> @e.DistanceKm km</p>

                        <div class="mb-3">
                            @if (e.EventDate.Date < DateTime.Today)
                            {
                                <span class="badge rd-status rd-status-cancelled">Past event</span>
                            }
                            @if (Model.EnrolledEventIds.Contains(e.EventID))
                            {
                                <span class="badge rd-status rd-status-confirmed">Enrolled</span>
                            }
                        </div>

                        <a asp-controller="EventDetails" asp-action="Index" asp-route-id="@e.EventID" class="btn btn-primary mt-auto">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}