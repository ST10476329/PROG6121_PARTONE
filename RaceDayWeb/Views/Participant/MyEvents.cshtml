@model List<EnrolmentItem>

@{
    ViewData["Title"] = "My events";
}

<h1>My events</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        You have not enrolled for any events yet.
        <a asp-action="Index">Browse upcoming events</a>.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Race number</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (EnrolmentItem en in Model)
            {
                <tr>
                    <td>@en.EventName</td>
                    <td>@en.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@en.CategoryName</td>
                    <td>@en.RaceNumber</td>
                    <td><partial name="_StatusBadge" model="en.Status" /></td>
                    <td class="text-nowrap">
                        <a asp-controller="EventDetails" asp-action="Index" asp-route-id="@en.EventID" class="btn btn-sm btn-outline-primary">View event</a>

                        @if (en.Status == "Confirmed")
                        {
                            <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this enrolment?');">
                                <input type="hidden" name="id" value="@en.EnrolmentID" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}